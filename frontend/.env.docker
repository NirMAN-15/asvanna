# ==============================================================================
# ASVANNA Frontend — Docker / Production Environment
# This file is used when building the Docker image for deployment.
# VITE_* variables are baked into the JS bundle at build time.
# ==============================================================================

# Use relative path so nginx can proxy /api/* to the backend container.
# This works regardless of the server's IP or domain name.
VITE_API_BASE_URL=/api/v1
