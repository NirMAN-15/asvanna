# ==============================================================================
# ASVANNA Production Environment Configuration (Backend)
# Replace placeholder values with your production server credentials
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration (Self-hosted or Cloud: AWS RDS, Supabase, Neon, Railway)
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_USER=asvanna_prod_user
DB_PASSWORD=YourStrongProductionPassword123!
DB_NAME=asvanna_production
DB_SSL=true

# JSON Web Token (JWT) Security — Generate a 64+ char random string
JWT_SECRET=GENERATE_STRONG_RANDOM_SECRET_KEY_FOR_PRODUCTION_USE_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN_FARMER=24h
JWT_EXPIRES_IN_OFFICER=8h
JWT_EXPIRES_IN_BUYER=24h

# 4-Factor Agricultural Risk Engine Thresholds (Percentages)
RISK_SAFE_THRESHOLD=40.0
RISK_WARNING_THRESHOLD=65.0

# Geofencing Defaults for Bandarawela Division (km)
DEFAULT_GEOFENCE_RADIUS_KM=5.0
MAX_GEOFENCE_RADIUS_KM=20.0

# Live Weather Integration (Open-Meteo REST API)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# External Agricultural Data Providers
CROPIX_API_URL=https://api.cropix.gov.lk/v1
HARTI_API_URL=http://www.harti.gov.lk/

# Scheduled Daily Automated Background Intelligence Jobs
ENABLE_SCHEDULED_JOBS=true

# Firebase Cloud Messaging (FCM) — Production Push Notifications
# Obtain these from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=asvanna-agritech-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@asvanna-agritech-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://asvanna-agritech-prod-default-rtdb.firebaseio.com
